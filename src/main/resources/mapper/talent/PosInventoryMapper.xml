<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joao.storemanagement.mapper.talent.PosInventoryMapper">

    <select id="sumQuantityByProductGuid" resultType="java.math.BigDecimal">
        SELECT ISNULL(SUM(i.Quantity), 0)
        FROM dbo.Inventories i
        WHERE CAST(i.ProductGUID AS varchar(36)) = #{productGuid}
    </select>
</mapper>

